PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://job_tracker_user:job_tracker_dev_pw@localhost:5432/job_tracker?schema=public"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallback LLM providers - each is only used if its API key is set.
# When one hits its free-tier quota, the router automatically tries the next
# least-recently-used configured provider instead of failing the sync.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
